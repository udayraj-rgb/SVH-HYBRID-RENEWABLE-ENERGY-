# ==========================================
# TEJAS GRID — .gitignore
# ==========================================

# Virtual Environments (Python)
.venv/
venv/
env/
ENV/
*.venv/

# Python cache & artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Maven / Java build artifacts
target/
*.class
*.jar
*.war
*.ear
*.log
.mvn/timing.properties

# Frontend / Node.js
node_modules/
dist/
build/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & Editor files
.idea/
.vscode/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/

# OS specific files
.DS_Store
Thumbs.db
desktop.ini

# Environment variables & secrets
.env
.env.local
.env.*.local
